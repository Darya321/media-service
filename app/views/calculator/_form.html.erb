<%= form_with url: estimate_calculator_path,
              method: :post,
              class: "calculator-form",
              data: { calculator_target: "form", action: "submit->calculator#submit", turbo: false } do %>
  <% if @calculator_errors.present? %>
    <div class="form-errors" role="alert" data-calculator-target="errors">
      <p class="form-errors__title">Проверьте параметры расчёта:</p>
      <ul>
        <% @calculator_errors.each_value do |messages| %>
          <% messages.each do |message| %><li><%= message %></li><% end %>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="form-errors" role="alert" data-calculator-target="errors" hidden></div>
  <% end %>

  <fieldset class="calculator-step">
    <legend><span>1.</span> Товар</legend>

    <p class="field-label" id="product-type-label">Что упаковываем</p>
    <div class="choice-row" role="group" aria-labelledby="product-type-label">
      <% {
        "candles" => [ "Свечи", "Свечи в стекле" ],
        "cosmetics" => [ "Косметика", "Косметика" ],
        "clothes" => [ "Одежда", "Одежда" ],
        "other" => [ "Другое", "Другое" ]
      }.each do |key, (label, value)| %>
        <% id = "product_#{key}" %>
        <%= radio_button_tag :product_type, value, values[:product_type] == value, id: id, class: "choice-input" %>
        <%= label_tag id, label, class: "choice-chip" %>
      <% end %>
    </div>

    <div class="field-grid field-grid--four">
      <div class="field">
        <%= label_tag :length_mm, "Длина, мм" %>
        <%= number_field_tag :length_mm, values[:length_mm], min: 1, max: 5000, required: true %>
      </div>
      <div class="field">
        <%= label_tag :width_mm, "Ширина, мм" %>
        <%= number_field_tag :width_mm, values[:width_mm], min: 1, max: 5000, required: true %>
      </div>
      <div class="field">
        <%= label_tag :height_mm, "Высота, мм" %>
        <%= number_field_tag :height_mm, values[:height_mm], min: 1, max: 5000, required: true %>
      </div>
      <div class="field">
        <%= label_tag :weight_grams, "Вес, г" %>
        <%= number_field_tag :weight_grams, values[:weight_grams], min: 0, max: 100000, required: true %>
      </div>
    </div>

    <p class="field-label" id="fragility-label">Хрупкость</p>
    <div class="choice-row" role="group" aria-labelledby="fragility-label">
      <%= radio_button_tag :fragile, "true", values[:fragile].to_s == "true", id: "fragile_true", class: "choice-input" %>
      <%= label_tag :fragile_true, "Хрупкий (стекло)", class: "choice-chip" %>
      <%= radio_button_tag :fragile, "false", values[:fragile].to_s != "true", id: "fragile_false", class: "choice-input" %>
      <%= label_tag :fragile_false, "Нехрупкий", class: "choice-chip" %>
    </div>
  </fieldset>

  <fieldset class="calculator-step">
    <legend><span>2.</span> Упаковка</legend>

    <p class="field-label" id="material-label">Материал</p>
    <div class="choice-row" role="group" aria-labelledby="material-label">
      <% materials.each do |material| %>
        <% id = "material_#{material.slug}" %>
        <%= radio_button_tag :material_slug, material.slug, values[:material_slug] == material.slug,
              id: id, class: "choice-input", required: true %>
        <%= label_tag id, material.name, class: "choice-chip" %>
      <% end %>
    </div>

    <p class="field-label" id="print-label">Печать</p>
    <div class="choice-row" role="group" aria-labelledby="print-label">
      <% { "Полноцвет" => "full_color", "1 цвет" => "one_color", "Без печати" => "none" }.each do |label, value| %>
        <% id = "print_#{value}" %>
        <%= radio_button_tag :print_option, value, values[:print_option] == value, id: id, class: "choice-input" %>
        <%= label_tag id, label, class: "choice-chip" %>
      <% end %>
    </div>

    <p class="field-label" id="extras-label">Дополнительно</p>
    <div class="choice-row" role="group" aria-labelledby="extras-label">
      <% { "Вставка-фиксатор" => "insert", "Окно" => "window", "Лак" => "varnish" }.each do |label, value| %>
        <% id = "extra_#{value}" %>
        <%= check_box_tag "extras[]", value, Array(values[:extras]).include?(value), id: id, class: "choice-input" %>
        <%= label_tag id, label, class: "choice-chip" %>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="calculator-step calculator-step--last">
    <legend><span>3.</span> Условия</legend>
    <div class="field-grid field-grid--four">
      <div class="field">
        <%= label_tag :quantity, "Тираж, шт" %>
        <%= number_field_tag :quantity, values[:quantity], min: 1, max: 1000000, required: true %>
      </div>
      <div class="field">
        <%= label_tag :budget, "Бюджет, ₽" %>
        <%= number_field_tag :budget, values[:budget], min: 0, placeholder: "—" %>
      </div>
      <div class="field">
        <%= label_tag :deadline, "Срок" %>
        <%= date_field_tag :deadline, values[:deadline] %>
      </div>
      <div class="field">
        <%= label_tag :region, "Регион доставки" %>
        <%= select_tag :region,
              options_for_select([ "Москва", "Санкт-Петербург", "Центральный регион", "Другой регион" ], values[:region]),
              required: true %>
      </div>
    </div>
  </fieldset>

  <%= submit_tag "Рассчитать", class: "button button--accent calculator-form__submit", data: { calculator_target: "submit" } %>
<% end %>

<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "Скоро — Упаковано" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Скоро здесь будет медиасервис об упаковке для малого бизнеса.">
    <meta name="theme-color" content="#EEEDE9">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag "brand/upakovano-leaf.png", type: "image/png" %>
    <%= tag.link rel: "apple-touch-icon", href: asset_path("brand/upakovano-leaf.png") %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="page holding-page" data-controller="typography">
    <a class="skip-link" href="#main-content">Перейти к содержанию</a>
    <main id="main-content"><%= yield %></main>
  </body>
</html>

<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "Упаковано — медиа и инструменты об упаковке" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Материалы, предварительный расчёт и поставщики упаковки для малого бизнеса.">
    <meta name="theme-color" content="#EEEDE9">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="page page--<%= controller_name.dasherize %>">
    <a class="skip-link" href="#main-content">Перейти к содержанию</a>
    <%= render "shared/header" %>
    <%= render "shared/flash" %>

    <main id="main-content">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>

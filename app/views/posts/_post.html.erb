<article class="post-card <%= "post-card--featured" if post.featured? %>" data-post-slug="<%= post.slug %>">
  <%= link_to post_path(post), class: "post-card__link" do %>
    <div class="post-card__cover media-visual media-visual--<%= post.category.slug %>">
      <span class="media-visual__index" aria-hidden="true"><%= post_kind_label(post.kind).first %></span>
      <span class="media-visual__label"><%= post.category.name %></span>
    </div>
    <div class="post-card__body">
      <div class="post-card__meta">
        <span><%= post_kind_label(post.kind) %></span>
        <span><%= post.category.name %></span>
      </div>
      <h2><%= post.title %></h2>
      <p><%= post.summary %></p>
      <span class="post-card__more">Читать →</span>
    </div>
  <% end %>
</article>

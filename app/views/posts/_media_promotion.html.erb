<article class="media-promotion" data-post-slug="<%= post.slug %>">
  <div class="media-promotion__content">
    <p class="eyebrow">Для малого бизнеса · <%= post_placement_label(post) %></p>
    <h2><%= post.title %></h2>
    <p><%= post.summary %></p>
    <% if (cta_url = post_cta_url(post)) %>
      <%= link_to post.cta_label.presence || "Смотреть предложение",
            cta_url,
            class: "button button--dark",
            target: ("_blank" if post_external_cta?(post)),
            rel: ("noopener noreferrer" if post_external_cta?(post)) %>
      <% if post_external_cta?(post) %><span class="media-promotion__external">Внешний сайт ↗</span><% end %>
    <% end %>
  </div>
  <div class="media-promotion__visual">
    <% if (asset = post_cover_asset(post)) %>
      <%= image_tag asset, alt: "Иллюстрация предложения «#{post.title}»" %>
    <% end %>
  </div>
</article>

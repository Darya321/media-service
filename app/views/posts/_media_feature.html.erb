<article class="media-hero" data-post-slug="<%= post.slug %>" data-category="<%= post.category.slug %>">
  <div class="media-hero__content">
    <p class="eyebrow">Медиа · <%= post.category.name %></p>
    <% if (placement_label = post_placement_label(post)) %>
      <span class="media-hero__placement"><%= placement_label %></span>
    <% end %>
    <h1>Медиа<br>об упаковке</h1>
    <p>Знания, новости отрасли и предложения, которые помогают принимать обоснованные решения.</p>
    <%= link_to post_path(post), class: "button button--accent" do %>
      Читать главный материал <span aria-hidden="true">→</span>
    <% end %>
  </div>
  <div class="media-hero__visual media-visual media-visual--<%= post.category.slug %>">
    <span class="media-visual__index" aria-hidden="true">01</span>
    <span class="media-visual__label"><%= post.category.name %></span>
    <div class="media-hero__story">
      <span><%= post_kind_label(post.kind) %></span>
      <h2><%= link_to post.title, post_path(post) %></h2>
    </div>
  </div>
</article>

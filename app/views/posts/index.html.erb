<% content_for :title, "Медиа об упаковке — Упаковано" %>

<section class="media-page container">
  <%= render "media_feature", post: @hero_post if @hero_post %>

  <div class="media-toolbar">
    <nav class="media-categories" aria-label="Темы публикаций">
      <%= link_to "Все",
            posts_path(q: @query.presence),
            class: ("is-active" if params[:category].blank?),
            aria: (params[:category].blank? ? { current: "page" } : nil) %>
      <% @media_categories.each do |category| %>
        <%= link_to category.name,
              posts_path(q: @query.presence, category: category.slug),
              class: ("is-active" if @selected_category == category),
              aria: (@selected_category == category ? { current: "page" } : nil) %>
      <% end %>
    </nav>

    <%= form_with url: posts_path, method: :get, class: "media-search", data: { turbo: false } do %>
      <%= label_tag :q, "Поиск по медиа", class: "visually-hidden" %>
      <%= search_field_tag :q, @query, placeholder: "Поиск по медиа", aria: { label: "Поиск по медиа" } %>
      <%= hidden_field_tag :category, params[:category] if params[:category].present? %>
      <%= button_tag "Найти", type: :submit, name: nil, class: "button button--dark" %>
    <% end %>
  </div>

  <% if @filtering %>
    <section class="media-results" aria-labelledby="media-results-title">
      <header class="media-section__heading">
        <div>
          <p class="eyebrow">Результаты</p>
          <h2 id="media-results-title">
            <% if @query.present? %>
              По запросу «<%= @query %>»
            <% elsif @selected_category %>
              <%= @selected_category.name %>
            <% else %>
              Неизвестная тема
            <% end %>
          </h2>
        </div>
        <p>Найдено: <%= @posts.size %></p>
      </header>

      <% if @posts.any? %>
        <div class="media-section__grid"><%= render partial: "media_card", collection: @posts, as: :post %></div>
      <% else %>
        <div class="media-empty card" role="status">
          <p class="eyebrow">Ничего не найдено</p>
          <h3>Попробуйте изменить запрос «<%= @query.presence || params[:category] %>»</h3>
          <p>Можно выбрать другую тему или вернуться ко всем публикациям.</p>
          <%= link_to "Сбросить фильтры", posts_path, class: "button button--dark" %>
        </div>
      <% end %>
  <% else %>
    <% if @supplier_posts.any? %>
      <section class="media-section" data-section="suppliers" aria-labelledby="supplier-news-title">
        <header class="media-section__heading">
          <div>
            <p class="eyebrow">Отрасль</p>
            <h2 id="supplier-news-title">Новости производителей<br>и поставщиков</h2>
          </div>
          <p>Новые материалы, технологии производства и актуальные предложения компаний.</p>
        </header>
        <div class="media-section__grid"><%= render partial: "media_card", collection: @supplier_posts, as: :post %></div>
      </section>
    <% end %>

    <%= render "media_promotion", post: @business_feature if @business_feature %>

    <% if @legislation_posts.any? %>
      <section class="media-section" data-section="legislation" aria-labelledby="legislation-title">
        <header class="media-section__heading">
          <div>
            <p class="eyebrow">Правила рынка</p>
            <h2 id="legislation-title">Законодательство<br>и регулирование</h2>
          </div>
          <p>Объясняем изменения требований простым языком. Материалы не заменяют юридическую консультацию.</p>
        </header>
        <div class="media-section__grid"><%= render partial: "media_card", collection: @legislation_posts, as: :post %></div>
      </section>
    <% end %>
  <% end %>

  <section class="media-subscription home-subscription" aria-labelledby="media-subscription-title">
    <div>
      <p class="eyebrow">Полезное — в одном письме</p>
      <h2 id="media-subscription-title">Подпишитесь<br>на материалы</h2>
      <p>Новые разборы, предложения и важные изменения отрасли.</p>
    </div>
    <%= render "subscriptions/form", subscription: @subscription, message: nil %>
  </section>
</section>

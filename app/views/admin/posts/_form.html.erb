<%= render "admin/shared/form_errors", record: post %>

<%= form_with model: [:admin, post], class: "admin-form" do |form| %>
  <div class="admin-form__grid">
    <div class="field">
      <%= form.label :category_id, "Категория" %>
      <%= form.collection_select :category_id, @categories, :id, :name, { prompt: "Выберите категорию" }, required: true %>
    </div>
    <div class="field">
      <%= form.label :kind, "Тип" %>
      <%= form.select :kind, admin_post_kind_options %>
    </div>
    <div class="field">
      <%= form.label :status, "Статус" %>
      <%= form.select :status, admin_post_status_options %>
    </div>
    <div class="field">
      <%= form.label :published_at, "Дата публикации" %>
      <%= form.datetime_local_field :published_at %>
    </div>
  </div>
  <div class="field">
    <%= form.label :title, "Заголовок" %>
    <%= form.text_field :title, required: true %>
  </div>
  <div class="field">
    <%= form.label :slug, "Адрес страницы" %>
    <%= form.text_field :slug, required: true, placeholder: "how-to-choose-cardboard" %>
  </div>
  <div class="field">
    <%= form.label :summary, "Краткое описание" %>
    <%= form.text_area :summary, rows: 3, required: true %>
  </div>
  <div class="field">
    <%= form.label :body, "Текст" %>
    <%= form.text_area :body, rows: 14, required: true %>
  </div>
  <div class="admin-form__grid">
    <div class="field">
      <%= form.label :placement, "Размещение" %>
      <%= form.select :placement, admin_post_placement_options %>
      <small>Редакционный материал — без рекламы; партнёрский ведёт в карточку компании.</small>
    </div>
    <div class="field">
      <%= form.label :supplier_id, "Компания" %>
      <%= form.collection_select :supplier_id, @suppliers, :id, :name, { include_blank: "Без компании" } %>
      <small>Обязательна только для партнёрского материала.</small>
    </div>
    <div class="field">
      <%= form.label :cta_label, "Текст кнопки" %>
      <%= form.text_field :cta_label, placeholder: "Открыть компанию" %>
    </div>
    <div class="field">
      <%= form.label :external_url, "Внешняя ссылка" %>
      <%= form.url_field :external_url, placeholder: "https://company.example/offer" %>
      <small>Используется только для внешней рекламы.</small>
    </div>
  </div>
  <div class="admin-form__grid">
    <div class="field">
      <%= form.label :cover_asset, "Файл обложки" %>
      <%= form.text_field :cover_asset, placeholder: "cover.svg" %>
    </div>
    <label class="check-field"><%= form.check_box :featured %> Показывать как избранное</label>
  </div>
  <%= form.submit post.persisted? ? "Сохранить публикацию" : "Создать публикацию", class: "button button--accent" %>
<% end %>

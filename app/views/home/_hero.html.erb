<section id="hero" class="hero-shell">
  <div class="hero-shell__stage container">
    <p class="identity-wordmark" data-full-bleed-wordmark aria-hidden="true">Упаковано</p>

    <%= image_tag "figma/hero-packaging-island-node-203-270.png",
                  class: "hero-shell__art",
                  alt: "Открытая картонная коробка и листы гофрокартона на зеленом острове",
                  width: 546,
                  height: 331 %>

    <div class="hero-shell__copy">
      <p class="eyebrow">Медиа + инструменты</p>
      <h1>Упаковка, которая работает на бизнес</h1>
      <p class="hero-shell__lead">Исследуем материалы. Сравниваем затраты. Выбираем осознанно.</p>
    </div>
  </div>
</section>

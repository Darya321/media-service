<% content_for :title, "Упаковано — упаковка, которая работает на бизнес" %>

<div class="homepage" data-controller="repeat-order">
  <%= render "hero" %>
  <%= render "tools" %>
  <%= render "steps" %>
  <%= render "calculator", materials: @materials, values: @calculator_values, result: @reference_result %>
  <%= render "supplier_comparison", suppliers: @suppliers %>
  <%= render "media", posts: @posts %>
  <%= render "repeat_order" %>
  <%= render "manufacturer_cta" %>

  <section id="subscription" class="home-subscription container">
    <div>
      <p class="eyebrow">Письма об упаковке</p>
      <h2>Новые разборы — без лишнего шума</h2>
    </div>
    <%= render "subscriptions/form", subscription: @subscription, message: nil %>
  </section>
</div>
